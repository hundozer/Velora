// Prisma schema for Velora - Premium Adult Social Marketplace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  CREATOR
  COUPLE
  ADMIN
  AMBASSADOR
}

enum MemberTier {
  FREE
  PREMIUM
  VIP
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationLevel {
  LEVEL_1_EMAIL
  LEVEL_2_PHONE
  LEVEL_3_PROFILE_BIOMETRIC
  LEVEL_4_CREATOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  TRANSGENDER
  COUPLE_MF
  COUPLE_FF
  COUPLE_MM
  OTHER
}

enum SexualOrientation {
  HETEROSEXUAL
  BISEXUAL
  HOMOSEXUAL
  PANSEXUAL
  FLUID
  QUEER
}

enum RelationshipStatus {
  SINGLE
  ATTACHED
  OPEN_RELATIONSHIP
  COUPLE
  SWINGER
  POLYAMOROUS
}

enum Visibility {
  PUBLIC
  PRIVATE_MEMBERS
  FAVORITES_ONLY
  SUBSCRIBERS_ONLY
  PAID_PER_VIEW
}

enum ContentPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StreamAccessType {
  FREE
  TICKETED_PPV
  SUBSCRIBER_ONLY
  PRIVATE_ONE_ON_ONE
}

enum StreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  SUSPENDED
}

enum CommunityType {
  LOCATION_CITY
  INTEREST_GROUP
  CREATOR_FAN_CLUB
  PRIVATE_INVITE_ONLY
}

enum EventType {
  SOCIAL_MEETUP
  NIGHTLIFE_VIP
  CREATOR_APPEARANCE
  PRIVATE_COMMUNITY_GATHERING
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum AttachmentType {
  STANDARD_IMAGE
  DISAPPEARING_IMAGE
  PRIVATE_PHOTO_REQUEST
  AUDIO_VOICE
}

enum MessagePermissionRules {
  EVERYONE
  VERIFIED_ONLY
  FAVORITES_ONLY
  NOBODY
}

enum NotificationType {
  PROFILE_VIEW
  FAVORITED
  NEW_MESSAGE
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  CONTENT_UNLOCKED
  NEW_FOLLOWER
  NEW_SUBSCRIBER
  PAYMENT_RECEIVED
  PAYOUT_STATUS_UPDATE
  STREAM_SCHEDULED
  STREAM_LIVE_NOW
  COMMUNITY_POST
  EVENT_INVITATION
  REFERRAL_CONVERSION
  REPORT_STATUS_UPDATE
}

enum ReportReason {
  FAKE_PROFILE
  HARASSMENT
  SPAM_SOLICITATION
  INAPPROPRIATE_CONTENT
  SCAM_BEHAVIOUR
  UNDERAGE_SUSPICION
  NON_CONSENTUAL_CONTENT
  OFFSITE_PAYMENT
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED_ACTION_TAKEN
  DISMISSED
}

enum ModerationActionType {
  WARN_USER
  SUSPEND_ACCOUNT_7_DAYS
  SUSPEND_ACCOUNT_30_DAYS
  BAN_USER_PERMANENT
  REMOVE_CONTENT
  SUSPEND_LIVE_STREAM
  REMOVE_COMMUNITY_POST
}

enum PaymentType {
  CREATOR_SUBSCRIPTION
  PREMIUM_ALBUM_UNLOCK
  PRIVATE_VIDEO_UNLOCK
  LIVE_EXPERIENCE_TICKET
  EVENT_ENTRY_TICKET
  CREATOR_TIP
  WALLET_TOPUP
  MEMBERSHIP_UPGRADE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  username           String             @unique
  role               UserRole           @default(MEMBER)
  memberTier         MemberTier         @default(FREE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationLevel  VerificationLevel  @default(LEVEL_1_EMAIL)
  reputationBadge    String             @default("Verified Member")
  preferredLanguage  String             @default("en")
  preferredCurrency  String             @default("USD")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  profile              Profile?
  creatorProfile       CreatorProfile?
  wallet               Wallet?
  sentMessages         Message[]                 @relation("SentMessages")
  participants         ConversationParticipant[]
  verifications        VerificationRequest[]     @relation("UserVerifications")
  reviewedVerifications VerificationRequest[]    @relation("AdminReviewedVerifications")
  creatorApplications  CreatorApplication[]      @relation("UserCreatorApplications")
  reportsFiled         UserReport[]              @relation("ReportsFiled")
  reportsReceived      UserReport[]              @relation("ReportsReceived")
  moderationActions    ModerationActionLog[]     @relation("AdminActionsPerformed")
  userSanctions        ModerationActionLog[]     @relation("UserSanctionsReceived")
  subscriptions        Subscription[]            @relation("UserSubscriptions")
  purchases            PaymentTransaction[]      @relation("BuyerTransactions")
  earnings             PaymentTransaction[]      @relation("SellerTransactions")
  favorites            UserFavorite[]            @relation("UserFavorites")
  favoritedBy          UserFavorite[]            @relation("TargetFavorites")
  following            UserFollow[]              @relation("UserFollowing")
  blockedUsers         UserBlock[]               @relation("BlockerUsers")
  blockedBy            UserBlock[]               @relation("BlockedUsers")
  notifications        Notification[]            @relation("UserNotifications")
  safetySettings       UserSafetySettings?
  contentPurchases     ContentPurchase[]         @relation("UserContentPurchases")
  payoutRequests       PayoutRequest[]           @relation("UserPayoutRequests")
  refundRequests       RefundRequest[]           @relation("UserRefundRequests")
  streamTickets        StreamTicket[]            @relation("UserStreamTickets")
  liveTipsSent         LiveTip[]                 @relation("TipsSent")
  chatMessagesSent     LiveChatMessage[]         @relation("UserLiveChatMessages")
  communityMemberships CommunityMember[]        @relation("UserCommunityMemberships")
  communityPosts       CommunityPost[]           @relation("UserCommunityPosts")
  postComments         PostComment[]             @relation("UserPostComments")
  eventTickets         EventTicket[]             @relation("UserEventTickets")
  eventsHosted         VeloraEvent[]             @relation("UserHostedEvents")
  referralLinks        ReferralLink[]            @relation("UserReferralLinks")
  auditLogs            AuditLog[]                @relation("UserAuditLogs")

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([memberTier])
  @@index([verificationStatus])
  @@index([verificationLevel])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  currency         String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Profile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  dateOfBirth        DateTime
  age                Int
  gender             Gender
  sexualOrientation  SexualOrientation
  country            String
  city               String
  location           String
  latitude           Float?
  longitude          Float?
  languages          String[]
  headline           String?            @db.VarChar(255)
  bio                String?            @db.Text
  interests          String[]
  hobbies            String[]
  lifestyleTags      String[]
  relationshipStatus RelationshipStatus
  lookingFor         String[]
  isCoupleProfile    Boolean            @default(false)

  partnerDisplayName String?
  partnerAge         Int?
  partnerGender      Gender?

  publicProfileVisibility Boolean       @default(true)
  photoVisibilityDefault  Visibility    @default(PUBLIC)
  locationPrecision       String        @default("CITY")
  showOnlineStatus        Boolean       @default(true)
  showDistance            Boolean       @default(true)
  allowDirectMessages     Boolean       @default(true)
  requireVerificationToMessage Boolean  @default(false)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  preferences        Preferences?
  media              Media[]

  @@index([location])
  @@index([country])
  @@index([city])
  @@index([age])
  @@index([gender])
  @@index([relationshipStatus])
}

model Preferences {
  id                    String      @id @default(uuid())
  profileId             String      @unique
  profile               Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  minAge                Int         @default(18)
  maxAge                Int         @default(99)
  maxDistanceKm         Int         @default(100)
  preferredGenders      Gender[]
  preferredOrientations SexualOrientation[]
  preferredProfileTypes String[]
  preferredLookingFor   String[]
  verifiedOnly          Boolean     @default(false)
  creatorsOnly          Boolean     @default(false)
  photosAvailableOnly   Boolean     @default(true)
  onlineOnly            Boolean     @default(false)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model UserSafetySettings {
  id                          String                 @id @default(uuid())
  userId                      String                 @unique
  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  whoCanMessageMe             MessagePermissionRules @default(EVERYONE)
  allowPhotoMessages          Boolean                @default(true)
  allowRequestsFromUnknown    Boolean                @default(true)
  enableMessageFiltering     Boolean                @default(true)
  profileVisibilitySetting    String                 @default("MEMBERS_ONLY")
  hideLastActive              Boolean                @default(false)
  appearInSearch              Boolean                @default(true)
  dailyMessageLimit           Int                    @default(50)
  messagesSentToday           Int                    @default(0)
  enablePushMessages          Boolean                @default(true)
  enablePushLivestreams       Boolean                @default(true)
  enablePushEvents            Boolean                @default(true)

  updatedAt                   DateTime               @updatedAt
}

model Media {
  id           String     @id @default(uuid())
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url          String
  previewUrl   String?
  type         MediaType  @default(IMAGE)
  visibility   Visibility @default(PUBLIC)
  price        Float?     @default(0)
  title        String?
  description  String?
  sortOrder    Int        @default(0)
  isProfilePhoto Boolean  @default(false)
  isCoverPhoto Boolean    @default(false)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([profileId])
  @@index([visibility])
}

model Community {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String        @db.Text
  coverImageUrl String
  type          CommunityType @default(LOCATION_CITY)
  location      String?
  rules         String[]
  isPrivate     Boolean       @default(false)
  membersCount  Int           @default(0)
  postsCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  members       CommunityMember[] @relation("CommunityMembers")
  posts         CommunityPost[]   @relation("CommunityPosts")
  events        VeloraEvent[]     @relation("CommunityEvents")

  @@index([type])
  @@index([location])
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation("CommunityMembers", fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("UserCommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
}

model CommunityPost {
  id          String        @id @default(uuid())
  communityId String
  community   Community     @relation("CommunityPosts", fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation("UserCommunityPosts", fields: [authorId], references: [id], onDelete: Cascade)
  title       String?
  content     String        @db.Text
  mediaUrls   String[]
  likesCount  Int           @default(0)
  commentsCount Int         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments    PostComment[] @relation("PostComments")

  @@index([communityId])
  @@index([authorId])
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("UserPostComments", fields: [authorId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([postId])
}

model VeloraEvent {
  id             String           @id @default(uuid())
  hostId         String
  host           User             @relation("UserHostedEvents", fields: [hostId], references: [id], onDelete: Cascade)
  communityId    String?
  community      Community?       @relation("CommunityEvents", fields: [communityId], references: [id])
  title          String
  description    String           @db.Text
  eventType      EventType        @default(SOCIAL_MEETUP)
  location       String
  venueName      String
  scheduledDate  DateTime
  capacity       Int              @default(50)
  attendeesCount Int              @default(0)
  ticketPrice    Float            @default(0)
  coverImageUrl  String
  rules          String[]
  status         ContentPublicationStatus @default(PUBLISHED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tickets        EventTicket[]    @relation("EventTickets")

  @@index([hostId])
  @@index([location])
  @@index([eventType])
}

model EventTicket {
  id          String      @id @default(uuid())
  eventId     String
  event       VeloraEvent @relation("EventTickets", fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation("UserEventTickets", fields: [userId], references: [id], onDelete: Cascade)
  ticketCode  String      @unique
  pricePaid   Float
  purchasedAt DateTime    @default(now())

  @@unique([eventId, userId])
}

model ReferralLink {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserReferralLinks", fields: [userId], references: [id], onDelete: Cascade)
  code            String   @unique
  clicksCount     Int      @default(0)
  conversionsCount Int     @default(0)
  rewardsEarnedDays Int    @default(0)
  createdAt       DateTime @default(now())
}

model CreatorProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyPrice       Float          @default(19.99)
  categories         String[]
  bio                String?        @db.Text
  welcomeMessage     String?
  followersCount     Int            @default(0)
  subscribersCount   Int            @default(0)
  totalEarnings      Float          @default(0)
  pendingEarnings    Float          @default(0)
  availablePayout    Float          @default(0)
  payoutMethod       String?
  payoutDetails      String?
  isLiveNow          Boolean        @default(false)
  nextScheduledLive  DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subscriptions      Subscription[]   @relation("CreatorSubscriptions")
  followers          UserFollow[]     @relation("CreatorFollowers")
  albums             ContentAlbum[]   @relation("CreatorAlbums")
  videos             ContentVideo[]   @relation("CreatorVideos")
  contentPurchases   ContentPurchase[] @relation("CreatorContentSales")
  payoutRequests     PayoutRequest[]  @relation("CreatorPayoutRequests")
  liveStreams        LiveStream[]     @relation("CreatorLiveStreams")
  tipsReceived       LiveTip[]        @relation("TipsReceived")

  @@index([userId])
}

model LiveStream {
  id                String           @id @default(uuid())
  creatorId         String
  creator           CreatorProfile   @relation("CreatorLiveStreams", fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  description       String?          @db.Text
  category          String
  thumbnailUrl      String
  accessType        StreamAccessType @default(TICKETED_PPV)
  ticketPrice       Float            @default(0)
  status            StreamStatus     @default(SCHEDULED)
  scheduledStartTime DateTime
  durationMinutes   Int              @default(60)
  currentViewersCount Int            @default(0)
  peakViewersCount  Int              @default(0)
  totalRevenue      Float            @default(0)
  streamUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tickets           StreamTicket[]   @relation("StreamTickets")
  tips              LiveTip[]        @relation("StreamTips")
  chatMessages      LiveChatMessage[] @relation("StreamChatMessages")

  @@index([creatorId])
  @@index([status])
  @@index([accessType])
}

model StreamTicket {
  id           String     @id @default(uuid())
  streamId     String
  stream       LiveStream @relation("StreamTickets", fields: [streamId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("UserStreamTickets", fields: [userId], references: [id], onDelete: Cascade)
  pricePaid    Float
  purchasedAt  DateTime   @default(now())

  @@unique([streamId, userId])
}

model LiveTip {
  id           String     @id @default(uuid())
  streamId     String
  stream       LiveStream @relation("StreamTips", fields: [streamId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("TipsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId   String
  receiver     CreatorProfile @relation("TipsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  amount       Float
  message      String?
  createdAt    DateTime   @default(now())

  @@index([streamId])
}

model LiveChatMessage {
  id           String     @id @default(uuid())
  streamId     String
  stream       LiveStream @relation("StreamChatMessages", fields: [streamId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("UserLiveChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderName   String
  senderAvatar String
  content      String     @db.Text
  isTipMessage Boolean    @default(false)
  tipAmount    Float?
  createdAt    DateTime   @default(now())

  @@index([streamId])
}

model ContentAlbum {
  id                String                   @id @default(uuid())
  creatorId         String
  creator           CreatorProfile           @relation("CreatorAlbums", fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  description       String?                  @db.Text
  category          String
  previewImages     String[]
  lockedImages      String[]
  price             Float                    @default(0)
  visibility        Visibility               @default(SUBSCRIBERS_ONLY)
  publicationStatus ContentPublicationStatus @default(PUBLISHED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  purchases         ContentPurchase[]        @relation("AlbumPurchases")

  @@index([creatorId])
  @@index([visibility])
}

model ContentVideo {
  id                String                   @id @default(uuid())
  creatorId         String
  creator           CreatorProfile           @relation("CreatorVideos", fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  description       String?                  @db.Text
  category          String
  previewThumbnail  String
  videoUrl          String
  durationSeconds   Int                      @default(120)
  price             Float                    @default(0)
  visibility        Visibility               @default(PAID_PER_VIEW)
  publicationStatus ContentPublicationStatus @default(PUBLISHED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  purchases         ContentPurchase[]        @relation("VideoPurchases")

  @@index([creatorId])
  @@index([visibility])
}

model UserFollow {
  id               String         @id @default(uuid())
  followerId       String
  follower         User           @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation("CreatorFollowers", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([followerId, creatorProfileId])
}

model ContentPurchase {
  id            String        @id @default(uuid())
  buyerId       String
  buyer         User          @relation("UserContentPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       CreatorProfile @relation("CreatorContentSales", fields: [creatorId], references: [id], onDelete: Cascade)
  albumId       String?
  album         ContentAlbum? @relation("AlbumPurchases", fields: [albumId], references: [id])
  videoId       String?
  video         ContentVideo? @relation("VideoPurchases", fields: [videoId], references: [id])
  price         Float
  status        PaymentStatus @default(COMPLETED)
  createdAt     DateTime      @default(now())

  @@index([buyerId])
  @@index([creatorId])
}

model PayoutRequest {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation("UserPayoutRequests", fields: [userId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation("CreatorPayoutRequests", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String         @default("USD")
  payoutMethod     String
  payoutDetails    String
  status           PayoutStatus   @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model RefundRequest {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation("UserRefundRequests", fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Float
  reason        String        @db.Text
  status        RefundStatus  @default(PENDING)
  adminNotes    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model CreatorApplication {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation("UserCreatorApplications", fields: [userId], references: [id], onDelete: Cascade)
  categories         String[]
  proposedMonthlyPrice Float            @default(19.99)
  bio                String             @db.Text
  payoutMethod       String
  payoutDetails      String
  agreedToTerms      Boolean            @default(true)
  status             VerificationStatus @default(PENDING)
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model Subscription {
  id               String         @id @default(uuid())
  subscriberId     String
  subscriber       User           @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation("CreatorSubscriptions", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  price            Float
  status           String         @default("ACTIVE")
  renewsAt         DateTime
  createdAt        DateTime       @default(now())

  @@index([subscriberId])
  @@index([creatorProfileId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  actorName   String?
  actorAvatar String?
  targetLink  String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount    Int          @default(0)

  @@unique([conversationId, userId])
}

model Message {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String         @db.Text
  mediaUrl       String?
  attachmentType AttachmentType @default(STANDARD_IMAGE)
  isDisappearing Boolean        @default(false)
  disappearTimerSec Int?
  isOpened       Boolean        @default(false)
  status         MessageStatus  @default(SENT)
  isLocked       Boolean        @default(false)
  unlockPrice    Float?
  isUnlocked     Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([status])
}

model VerificationRequest {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  requestedLevel    VerificationLevel @default(LEVEL_3_PROFILE_BIOMETRIC)
  idDocumentUrl     String?
  selfieWithNoteUrl String?
  phoneVerificationCode String?
  status            VerificationStatus @default(PENDING)
  rejectionNotes    String?
  reviewedById      String?
  reviewedBy        User?             @relation("AdminReviewedVerifications", fields: [reviewedById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([userId])
}

model UserReport {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User         @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         ReportReason
  details        String       @db.Text
  evidenceUrl    String?
  status         ReportStatus @default(PENDING)
  adminNotes     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([reportedUserId])
}

model ModerationActionLog {
  id           String               @id @default(uuid())
  adminId      String
  admin        User                 @relation("AdminActionsPerformed", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User                 @relation("UserSanctionsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       ModerationActionType
  reason       String
  notes        String?
  createdAt    DateTime             @default(now())

  @@index([targetUserId])
}

model UserFavorite {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("TargetFavorites", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, targetUserId])
}

model UserBlock {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockedUsers", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  buyerId         String
  buyer           User          @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        String?
  seller          User?         @relation("SellerTransactions", fields: [sellerId], references: [id])
  grossAmount     Float
  platformCut     Float         @default(0)
  creatorEarnings Float         @default(0)
  taxAmount       Float         @default(0)
  currency        String        @default("USD")
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  provider        String        @default("STRIPE_CONNECT")
  metadata        String?
  createdAt       DateTime      @default(now())

  refundRequests  RefundRequest[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([type])
}
