# Auth0 Configuration (Regular Web Application)
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email (server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@intimo.live

# Supabase. Never expose the service-role key through NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transitional server-only admin bootstrap. Comma-separated Auth0 `sub` values.
# Remove after roles move to the canonical server-managed user table.
INTIMO_ADMIN_AUTH0_SUBS=
# Bootstrap mapping. Keep SUPER_ADMIN entries extremely limited and migrate normal admins to internal assignments.
# Format: auth0|subject=SUPER_ADMIN,auth0|other=CONTENT_MODERATOR
INTIMO_ADMIN_ROLE_ASSIGNMENTS=
INTIMO_ADMIN_MFA_REQUIRED=true
# 32 random bytes encoded as 64 hex characters. Server-only; rotating it revokes
# the ability to decrypt existing TOTP enrollment secrets and requires re-enrollment.
INTIMO_ADMIN_MFA_ENCRYPTION_KEY=

# Cloudflare R2 media uploads
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=intimo-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=
# Free MVP safety invariant. The server also hard-codes this off; do not enable it.
MONETIZATION_ENABLED=false
