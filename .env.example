# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth + database). URL and anon key are public; the service-role key is server-only
# and must never be exposed through NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC key for the signed 18+ declaration cookie. 32+ random bytes.
INTIMO_COOKIE_SECRET=

# Transitional admin bootstrap (issue #10): comma-separated Supabase user ids.
INTIMO_ADMIN_USER_IDS=
# Format: <user-uuid>=SUPER_ADMIN,<user-uuid>=CONTENT_MODERATOR
INTIMO_ADMIN_ROLE_ASSIGNMENTS=
INTIMO_ADMIN_MFA_REQUIRED=true
# 32 random bytes as 64 hex characters. Rotating it forces admin TOTP re-enrollment.
INTIMO_ADMIN_MFA_ENCRYPTION_KEY=

# Resend transactional email (server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@intimo.live

# Cloudflare R2 media uploads
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=intimo-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# Server-only bearer secret for the scheduled privacy retention worker (32+ random bytes).
INTIMO_RETENTION_CRON_SECRET=
